#!/usr/bin/env python3
"""Extract all thesis topic titles from thesis_projects.json."""
import json
import sys

INPUT_FILE = "thesis_projects.json"


def main():
    path = sys.argv[1] if len(sys.argv) > 1 else INPUT_FILE
    with open(path) as f:
        data = json.load(f)

    topics = next(
        entry["data"]["topics"]
        for entry in data
        if isinstance(entry.get("data"), dict) and "topics" in entry["data"]
    )

    # Change this line below for different filtering criteria, e.g. to only include "Research" thesis types:
    # if(topic.get("thesis_type") == "Research")
    # Other possible filters could be based on the "supervisor" field, "department", or any other metadata available in the topic entries.
    titles = [topic["title"] for topic in topics]

    for title in titles:
        print(title)

    print(f"\nTotal: {len(titles)} titles", file=sys.stderr)


if __name__ == "__main__":
    main()
